# PostgreSQL
DB_NAME=dukteksi_db
DB_USER=postgres
DB_PASSWORD=ganti_dengan_password_database_yang_kuat
DB_PORT=5432

# Aplikasi
PORT_HTTP=80
FRONTEND_URL=http://localhost
JWT_SECRET=ganti_dengan_random_string_minimal_64_karakter
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false

# Admin awal
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@dukteksi.mil.id
SEED_ADMIN_PASSWORD=ganti_dengan_password_admin_yang_kuat
SEED_ADMIN_FULLNAME=Administrator Dukteksi
